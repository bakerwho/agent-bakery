{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/secret-guard.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/style-gate.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/secret-scan.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/style-gate.sh 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
