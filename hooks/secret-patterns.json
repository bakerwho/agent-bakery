[
  {"name": "AWS access key ID", "re": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b"},
  {"name": "AWS secret access key", "re": "(?i)aws_secret_access_key[\"']?\\s*[=:]\\s*[\"']?[A-Za-z0-9/+=]{40}"},
  {"name": "AWS session token", "re": "(?i)aws_session_token[\"']?\\s*[=:]\\s*[\"']?[A-Za-z0-9/+=]{100,}"},
  {"name": "Anthropic API key", "re": "\\bsk-ant-[A-Za-z0-9_-]{20,}"},
  {"name": "sk- API key (OpenAI, Langfuse and similar)", "re": "\\bsk-(?!ant-)[A-Za-z0-9_-]{20,}"},
  {"name": "Langfuse public key", "re": "\\bpk-lf-[A-Za-z0-9-]{20,}"},
  {"name": "GitHub token", "re": "\\b(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{50,})\\b"},
  {"name": "Slack token", "re": "\\bxox[abposr]-[A-Za-z0-9-]{10,}"},
  {"name": "Databricks token", "re": "\\bdapi[0-9a-f]{32}(-[0-9]+)?\\b"},
  {"name": "Google API key", "re": "\\bAIza[0-9A-Za-z_-]{35}\\b"},
  {"name": "Buildkite token", "re": "\\bbkua_[A-Za-z0-9]{40}\\b"},
  {"name": "LaunchDarkly key", "re": "\\b(api|sdk|mob)-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b"},
  {"name": "1Password service account token", "re": "\\bops_[A-Za-z0-9_-]{50,}"},
  {"name": "npm token", "re": "\\bnpm_[A-Za-z0-9]{36}\\b"},
  {"name": "JWT (API keys, sessions)", "re": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"},
  {"name": "Authorization header value", "re": "(?i)authorization[\"']?\\s*[:=]\\s*[\"']?(bearer|token|basic)\\s+[A-Za-z0-9._~+/=-]{20,}"},
  {"name": "Password in URL", "re": "\\b[a-z][a-z0-9+.-]*://[^/\\s:@\"']+:[^/\\s@\"']{6,}@"},
  {"name": "PEM private key", "re": "-----BEGIN ([A-Z]+ )?PRIVATE KEY-----"}
]
